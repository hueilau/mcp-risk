{
  "name": "mcp-risk",
  "version": "0.1.0",
  "description": "Pre-install and config risk checks for MCP servers and agent tools.",
  "type": "module",
  "bin": {
    "mcp-risk": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "risk",
    "audit",
    "cli",
    "agents"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hueilau/mcp-risk.git"
  },
  "bugs": {
    "url": "https://github.com/hueilau/mcp-risk/issues"
  },
  "homepage": "https://github.com/hueilau/mcp-risk#readme",
  "dependencies": {
    "cac": "^6.7.14",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.34",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
